# Supabase の Project Settings → API(または Connect)で確認できる値を入れて、
# このファイルを .env にコピーしてください。.env は Git に含まれません。
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Publishable key(sb_publishable_...)のみ。secret key / service_role key は絶対に入れないこと
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
